# 1. Java API
java_url=http://localhost:8080/api

# 2. MySQL
mysql_user=root
mysql_password=your_password
mysql_host=localhost
mysql_port=3306
mysql_database=your_db_name
mysql_pool_size=10
mysql_pool_recycle=3600
mysql_pool_timeout=30
mysql_max_overflow=20

# 3. LLM
llm_model=qwen-plus
llm_api_key=sk-your-api-key
llm_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1

# 4. Checkpointer: sqlite / async_sqlite / postgres
checkpointer_model=async_sqlite

# 5. SQLite
sqlite_url=agent/data/agent.db

# 6. PostgreSQL（仅 checkpointer_model=postgres 时需要）
pg_url=postgresql://user:pass@localhost/db
