# ByteSoul 配置文件
# 使用：cp config.yaml.example config.yaml，填写实际值

# ─────────────────────────── Java 后端服务 ───────────────────────────
java:
  url: http://localhost:8080/api           # 外部 Java API 地址

# ─────────────────────────── MySQL 数据库 ───────────────────────────
mysql:
  user: root                               # 数据库用户名
  password: your_password                  # 数据库密码
  host: localhost                          # 数据库地址
  port: 3306                               # 数据库端口
  database: your_db_name                   # 数据库名
  pool:
    size: 10                               # 空闲连接数
    recycle: 3600                          # 连接回收时间/秒
    timeout: 30                            # 获取连接超时/秒
    max_overflow: 20                       # 额外连接数

# ─────────────────────────── LLM 大语言模型 ───────────────────────────
llm:
  model: qwen-plus                         # 模型名称
  api_key: sk-your-api-key                 # API 密钥
  base_url: https://dashscope.aliyuncs.com/compatible-mode/v1  # 接口地址

# ─────────────────────────── Agent 短期记忆 ───────────────────────────
checkpointer:
  model: async_sqlite                      # 存储后端：sqlite / async_sqlite / postgres
  sqlite_url: agent/data/agent.db          # SQLite 路径
  pg_url: postgresql://user:pass@localhost/db  # PostgreSQL 连接串

# ─────────────────────────── RAG 配置 ───────────────────────────
rag:
  # 一、父子模式切割
  parent_delimiter: "\n\n"                 # 父块分隔符
  parent_max_size: 2000                    # 父块最大字符数
  child_delimiter: "\n\n"                  # 子块分隔符
  child_max_size: 500                      # 子块最大字符数
  child_overlap: 50                        # 子块重叠字符数

  # 二、嵌入模型（不填则复用 llm 配置）
  embedding:
    model: text-embedding-v3               # 模型名称
    dimensions: 1024                       # 向量维度

  # 三、Milvus 向量存储
  vectorstore:
    milvus_host: localhost                 # Milvus 地址
    milvus_port: 19530                     # Milvus 端口
    collection_name: bs_rag                # 集合名称

  # 四、Elasticsearch BM25 检索
  bm25:
    es_hosts: ["http://localhost:9200"]    # ES 地址
    index_name: bs_rag                     # 索引名称
    ik_analyzer: ik_max_word               # 索引分词器
    ik_search_analyzer: ik_smart           # 搜索分词器

  # 五、检索配置
  retrieval:
    top_k: 5                               # 返回结果数
    score_threshold: 0.7                   # 分数阈值

  # 六、检索前：查询优化
  pre_retrieval:
    enable_rewrite: true                   # 查询改写
    enable_expansion: true                 # 查询扩展
    expansion_count: 3                     # 扩展数量

  # 七、检索中：多路检索
  mid_retrieval:
    enable_bm25: true                      # BM25 关键词检索

  # 八、检索后：融合精排
  post_retrieval:
    enable_reranker: true                  # Cross-Encoder 重排序
    reranker_model: BAAI/bge-reranker-v2-m3  # 重排序模型
