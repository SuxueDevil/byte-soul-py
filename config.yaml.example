# ============================================================
# api-demo 配置文件
# ============================================================
# 使用方式：
#   1. 复制本文件为 config.yaml：cp config.yaml.example config.yaml
#   2. 填写下方实际值
#   3. 也可通过环境变量 CONFIG_FILE 指定其他路径，例如：
#      CONFIG_FILE=/etc/api-demo/config.yaml uv run uvicorn main:app
# ============================================================

# ------------------------------------------------------------
# Java 后端服务
# ------------------------------------------------------------
# ProductService 调用的外部 Java API 地址
# 目前 product_service.py 未挂载到路由，可先填占位值
java:
  url: http://localhost:8080/api

# ------------------------------------------------------------
# MySQL 数据库
# ------------------------------------------------------------
# 使用 asyncmy 驱动的异步连接，ORM 为 SQLAlchemy 2.0
# 表结构见 api/models/，启动前需确保数据库已创建
mysql:
  user: root
  password: your_password
  host: localhost
  port: 3306
  database: your_db_name

  # 连接池配置（均有默认值，不填则使用下方注释中的默认值）
  pool:
    # 同时维持的空闲连接数（默认 10）
    size: 10
    # 连接回收时间/秒，防止 MySQL 端超时断开（默认 3600）
    recycle: 3600
    # 从池中获取连接的超时时间/秒（默认 30）
    timeout: 30
    # 超出 pool_size 后允许额外创建的连接数（默认 20）
    max_overflow: 20

# ------------------------------------------------------------
# LLM 大语言模型
# ------------------------------------------------------------
# 使用 LangChain ChatOpenAI，兼容所有 OpenAI 接口规范的模型服务
# 项目中创建了两个实例：流式（chat_node 用）和非流式（intent_node 用）
llm:
  # 模型名称，如 qwen-plus、gpt-3.5-turbo、deepseek-chat 等
  model: qwen-plus
  # API 密钥，以 sk- 开头
  api_key: sk-your-api-key
  # OpenAI 兼容接口的基础 URL（不含 /chat/completions 后缀）
  # 阿里云 DashScope：https://dashscope.aliyuncs.com/compatible-mode/v1
  # OpenAI 官方：https://api.openai.com/v1
  # DeepSeek：https://api.deepseek.com
  base_url: https://dashscope.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------------
# Agent 短期记忆（Checkpointer）
# ------------------------------------------------------------
# LangGraph 的状态持久化方案，用于实现多轮对话记忆
# thread_id 由 ChatRequest.user 字段映射而来
checkpointer:
  # 存储后端，三选一：
  #   sqlite        — 同步 SQLite，适合简单场景
  #   async_sqlite  — 异步 SQLite（推荐），适配 astream_events 流式调用
  #   postgres      — PostgreSQL，适合生产环境多实例部署
  model: async_sqlite

  # SQLite 数据库文件路径（sqlite / async_sqlite 模式使用）
  # 目录会自动创建，已加入 .gitignore
  sqlite_url: agent/data/agent.db

  # PostgreSQL 连接串（仅 model=postgres 时需要）
  # 格式：postgresql://user:password@host:port/database
  pg_url: postgresql://user:pass@localhost/db

# ------------------------------------------------------------
# RAG 多路检索配置
# ------------------------------------------------------------
rag:
  # 切割模式：general（通用） / parent_child（父子）
  chunk_mode: parent_child
  # 父子模式配置
  parent_delimiter: "\n\n"       # 父块分隔符
  parent_max_size: 2000          # 父块最大字符数
  child_delimiter: "\n\n"        # 子块分隔符
  child_max_size: 500            # 子块最大字符数
  child_overlap: 50              # 子块重叠字符数
  # 通用模式配置（chunk_mode=general 时生效）
  chunk_size: 500
  chunk_overlap: 50

  # 嵌入模型（默认复用 LLM 配置）
  embedding:
    model: text-embedding-v3
    # api_key: sk-your-api-key      # 不填则复用 llm.api_key
    # base_url: https://...          # 不填则复用 llm.base_url
    dimensions: 1024                 # 向量维度

  # Milvus 向量存储
  vectorstore:
    milvus_host: localhost
    milvus_port: 19530
    collection_name: rag_embeddings

  # Elasticsearch BM25 检索
  bm25:
    es_hosts: ["http://localhost:9200"]
    index_name: rag_chunks
    ik_analyzer: ik_max_word         # 索引用 IK 粗粒度分词
    ik_search_analyzer: ik_smart     # 搜索用 IK 细粒度分词

  # 检索配置
  retrieval:
    top_k: 5
    score_threshold: 0.7

  # 检索前：查询优化
  pre_retrieval:
    enable_rewrite: true       # 查询改写
    enable_expansion: true     # 查询扩展
    expansion_count: 3         # 扩展查询数量
    enable_hyde: false         # 假设性文档嵌入

  # 检索中：多路检索
  mid_retrieval:
    enable_bm25: true          # BM25 关键词检索
    enable_compression: true   # 上下文压缩

  # 检索后：融合精排
  post_retrieval:
    enable_reranker: true      # Cross-Encoder 重排序
    reranker_model: BAAI/bge-reranker-v2-m3
